Screen {
    layout: vertical;
    background: $surface;
}

#scan-container {
    padding: 2 4;
    height: 100%;
}

#scan-title {
    text-align: center;
    padding: 1;
    text-style: bold;
    color: $text;
}

#scan-status {
    padding: 1 0;
    color: $text-muted;
}

#device-list {
    height: auto;
    max-height: 12;
    margin: 1 0;
}

#manual-row {
    height: auto;
    padding: 1 0;
}

#mac-input {
    width: 40;
}

#connect-btn {
    margin-left: 1;
}

#dash-container {
    padding: 1 3;
    height: 100%;
}

#connection-status {
    padding: 0 0 1 0;
    color: $text-muted;
}

#dash-main {
    height: 1fr;
}

#dash-left, #dash-right {
    width: 1fr;
    padding: 0 2;
}

.section-title {
    color: $primary;
    text-style: bold;
    padding: 1 0 0 0;
}

BatteryWidget, PowerFlowWidget, StatusWidget, InfoWidget {
    padding: 0 1;
}

AlertWidget {
    padding: 0 1;
    height: auto;
}

SparklineWidget, PowerSparklineWidget {
    padding: 0 1;
}

Header {
    background: $primary;
}
